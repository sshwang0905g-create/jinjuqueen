{
  "version": 2,
  "rewrites": [
    {
      "source": "/m",
      "destination": "/mobile.html"
    },
    {
      "source": "/api/fetch_naver",
      "destination": "/api/fetch_naver.js"
    },
    {
      "source": "/api/board",
      "destination": "/api/board.js"
    },
    {
      "source": "/api/properties",
      "destination": "/api/properties.js"
    },
    {
      "source": "/api/auth",
      "destination": "/api/auth.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
